# ── Environment variables (copy to .env and fill in) ─────────
PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/baggy_jeans_shop

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Admin login emails (comma-separated)
ADMIN_EMAILS=admin@yourstore.com

# Admin bootstrap password (strong, 12+ chars)
ADMIN_PASSWORD=UseAStrongPasswordHere

# Stripe secret key (for real payments — Phase 3)
# STRIPE_SECRET_KEY=sk_test_...

# SMTP credentials (for real email — Phase 3)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-password

# Cloudinary (for image optimization)
# CLOUDINARY_URL=cloudinary://...

# Node environment
NODE_ENV=development

# ── Card payments (Stripe) ──────────────────────────────────
# Stripe does not process PKR, so card totals convert to STRIPE_CURRENCY at
# PKR_PER_UNIT rupees per unit. COD / JazzCash / EasyPaisa charge rupees directly.
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
# From the Stripe dashboard (or `stripe listen`). Without it, card webhooks are
# rejected — the checkout success redirect still reconciles the order.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd
PKR_PER_UNIT=280

# ── Transactional email (Resend) ────────────────────────────
# Without a key, emails are logged instead of sent (dev fallback) and the
# password-reset link is returned in the API response.
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM="BA GGY <onboarding@resend.dev>"
STORE_EMAIL=you@yourstore.com
EMAIL_REPLY_TO=you@yourstore.com

# Public base URL used in email links and Stripe redirects
# APP_URL=https://your-store.example
