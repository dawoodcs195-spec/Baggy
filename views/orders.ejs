<header class="page-header">
  <div class="container">
    <h1 class="page-title page-title-animated" data-split-text>MY ORDERS</h1>
    <p class="page-desc" data-reveal>Past purchases & tracking</p>
  </div>
</header>

<section class="section orders-section">
  <div class="container">
    <% if (orders && orders.length > 0) { %>
      <div class="orders-list">
        <% orders.forEach(order => { %>
          <div class="order-card">
            <div class="order-card-header">
              <div>
                <h3 class="order-card-id">Order <%= order.orderId %></h3>
                <p class="order-card-date">Placed on <%= order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-PK', { day: 'numeric', month: 'long', year: 'numeric' }) : '—' %></p>
              </div>
              <span class="status-badge status-<%= order.status %>"><%= order.status %></span>
            </div>
            <div class="order-card-items">
              <% order.items.slice(0, 3).forEach(item => { %>
                <div class="order-card-item">
                  <img src="<%= imgUrl(item.image) %>" alt="<%= item.name %>" class="order-card-img" />
                  <div class="order-card-item-info">
                    <strong><%= item.name %></strong>
                    <span>Size: <%= item.size %> · Qty: <%= item.qty %></span>
                  </div>
                  <div class="order-card-item-price">₨<%= (item.price * item.qty).toLocaleString() %></div>
                </div>
              <% }) %>
              <% if (order.items.length > 3) { %>
                <p class="order-card-more">+ <%= order.items.length - 3 %> more item(s)</p>
              <% } %>
            </div>
            <div class="order-card-footer">
              <div class="order-card-total">
                <span>Total</span>
                <strong>₨<%= order.total.toLocaleString() %></strong>
              </div>
              <div class="order-card-actions">
                <a href="/order/<%= order.orderId %>" class="btn btn-ghost">View Details</a>
                <a href="/track?order_id=<%= order.orderId %>" class="btn btn-secondary">Track</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="orders-footer">
        <a href="/shop" class="btn btn-primary">Continue Shopping</a>
      </div>
    <% } else if (user) { %>
      <div class="orders-empty" data-reveal>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
        <h2>No orders yet</h2>
        <p>When you place an order, it'll show up here.</p>
        <a href="/shop" class="btn btn-primary">Start Shopping</a>
      </div>
    <% } else { %>
      <div class="orders-unauth" data-reveal>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <h2>Sign in to view your orders</h2>
        <p>Create an account or sign in to see your order history.</p>
        <a href="/account?action=login" class="btn btn-primary">Sign In</a>
        <a href="/account?action=register" class="btn btn-secondary">Create Account</a>
      </div>
    <% } %>
  </div>
</section>



