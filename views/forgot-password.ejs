<div class="auth-page">
  <div class="container">
    <div class="auth-layout">
      <div class="auth-visual">
        <img src="/public/images/b2.jpg" alt="" loading="lazy" />
        <div class="auth-visual-content">
          <div class="auth-brand">BA GGY</div>
          <p class="auth-eyebrow">Password Help</p>
          <p class="auth-quote">Fashion that moves with you.</p>
        </div>
      </div>

      <div class="auth-form-card" data-reveal>
        <h2 data-split-text>Forgot Password</h2>
        <p class="auth-sub">Enter your account email — we'll generate a secure reset link valid for 15 minutes.</p>

        <div id="fp-error" class="auth-error" style="display:none;"></div>
        <div id="fp-success" class="auth-success" style="display:none;"></div>

        <form id="forgot-form" autocomplete="on">
          <div class="form-group">
            <label for="fp-email">Email address *</label>
            <input type="email" id="fp-email" name="email" placeholder="you@example.com" required autocomplete="email" />
          </div>
          <button type="submit" class="btn btn-primary w-100" id="fp-submit">Send Reset Link</button>
        </form>

        <div id="fp-reset-box" style="display:none; margin-top:var(--space-4); padding:var(--space-4); border:1px solid var(--color-gray-300); background:var(--color-gray-100, #f7f7f5);">
          <p style="font-size:0.8125rem; margin-bottom:var(--space-2);"><strong>Your reset link (valid 15 minutes):</strong></p>
          <a id="fp-reset-link" href="#" style="font-size:0.8125rem; word-break:break-all; color:var(--color-accent);">Reset link</a>
          <p style="font-size:0.75rem; color:var(--color-gray-500); margin-top:var(--space-2);">
            Email delivery isn't configured yet, so the link is shown here. Open it to set a new password.
          </p>
        </div>

        <p class="auth-footer-link">
          Remembered it? <a href="/account?action=login">Back to sign in</a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('forgot-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errBox = document.getElementById('fp-error');
    const okBox = document.getElementById('fp-success');
    errBox.style.display = 'none';
    okBox.style.display = 'none';
    const email = document.getElementById('fp-email').value.trim();
    const btn = document.getElementById('fp-submit');
    btn.disabled = true;
    btn.textContent = 'Sending...';
    try {
      const res = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });
      const data = await res.json();
      if (data.ok) {
        okBox.textContent = data.message;
        okBox.style.display = 'block';
        if (data.resetUrl) {
          const box = document.getElementById('fp-reset-box');
          const link = document.getElementById('fp-reset-link');
          link.href = data.resetUrl;
          link.textContent = window.location.origin + data.resetUrl;
          box.style.display = 'block';
        }
      } else {
        errBox.textContent = data.message || 'Something went wrong';
        errBox.style.display = 'block';
      }
    } catch {
      errBox.textContent = 'Network error. Please try again.';
      errBox.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Reset Link';
    }
  });
</script>
