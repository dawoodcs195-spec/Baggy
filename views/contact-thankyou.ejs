<header class="page-header">
  <div class="container">
    <h1 class="page-title page-title-animated" data-split-text>MESSAGE SENT</h1>
    <p class="page-desc" data-reveal>Thanks for reaching out</p>
  </div>
</header>

<section class="section contact-thankyou-section">
  <div class="container">
    <div class="thankyou-layout">
      <div class="thankyou-icon-block" data-reveal>
        <div class="thankyou-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
      </div>
      <div class="thankyou-content" data-reveal style="transition-delay: 0.1s">
        <h2>We received your message</h2>
        <p>Someone from our team will get back to you within 24 hours. For order-specific inquiries, please include your order ID in the subject line.</p>
        <div class="thankyou-actions">
          <a href="/shop" class="btn btn-primary">Continue Shopping</a>
          <a href="/contact" class="btn btn-secondary">Send Another Message</a>
        </div>
      </div>
    </div>
  </div>
</section>



