<header class="page-header">
  <div class="container">
    <h1 class="page-title page-title-animated" data-split-text>MY ACCOUNT</h1>
    <p class="page-desc" data-reveal>Manage orders, wishlist & settings</p>
  </div>
</header>

<section class="section account-section">
  <div class="container">
    <div class="account-grid">
      <aside class="account-sidebar" data-reveal>
        <div class="account-avatar">
          <span class="avatar-letter"><%= user ? (user.name ? user.name.charAt(0).toUpperCase() : 'G') : 'G' %></span>
        </div>
        <h3 id="account-welcome-name"><%= user ? (user.name || 'Customer') : 'Welcome, Guest' %></h3>
        <p id="account-welcome-sub"><%= user
            ? 'Signed in as ' + (user.email || '') + '. Manage your orders, address, and preferences below.'
            : 'Sign in to access your orders, saved addresses, and wishlist.' %></p>
        <% if (!user) { %>
          <a href="/account?action=login" class="btn btn-primary w-100" id="signin-btn" style="margin-bottom:var(--space-3);">Sign In</a>
          <a href="/account?action=register" class="btn btn-ghost w-100" id="signup-btn" style="margin-bottom:var(--space-6);">Create Account</a>
        <% } else { %>
          <div class="account-signed-in-details">
            <a href="/account/orders" class="btn btn-primary w-100" style="margin-bottom:var(--space-3);">My Orders</a>
            <a href="/wishlist" class="btn btn-secondary w-100" style="margin-bottom:var(--space-3);">Wishlist (<%= wishlistCount %>)</a>
            <button class="btn btn-ghost w-100" id="account-logout-btn" style="margin-bottom:var(--space-6);">Sign Out</button>
          </div>
        <% } %>
        <ul class="account-nav">
          <li><a href="#" class="active" data-tab="orders">Orders</a></li>
          <li><a href="#" data-tab="addresses">Addresses</a></li>
          <li><a href="#" data-tab="settings">Settings</a></li>
        </ul>
      </aside>

      <div class="account-content" data-reveal>
        <!-- Orders Tab -->
        <div class="account-tab active" id="tab-orders">
          <% if (user) { %>
            <h2>Your orders</h2>
            <% if (orders && orders.length > 0) { %>
              <div class="account-orders-list">
                <% orders.forEach(order => { %>
                  <div class="account-order-card">
                    <div class="account-order-header">
                      <span class="admin-product-id" style="font-family:var(--font-mono);font-size:0.8125rem;color:var(--color-gray-500);"><%= order.orderId %></span>
                      <span class="status-badge status-<%= order.status %>"><%= order.status %></span>
                      <span style="font-size:0.8125rem;color:var(--color-gray-500);"><%= order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-PK', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %></span>
                    </div>
                    <div class="account-order-items">
                      <% order.items.slice(0, 2).forEach(item => { %>
                        <div style="display:flex;align-items:center;gap:var(--space-3);padding:var(--space-2) 0;border-bottom:1px solid var(--color-gray-100);">
                          <img src="<%= imgUrl(item.image) %>" alt="" style="width:44px;height:44px;object-fit:cover;"  />
                          <div style="flex:1;">
                            <strong style="font-size:0.9375rem;display:block;"><%= item.name %></strong>
                            <span style="font-size:0.8125rem;color:var(--color-gray-500);">Size <%= item.size %> · Qty <%= item.qty %></span>
                          </div>
                          <div style="font-weight:700;align-self:flex-start;">₨<%= (item.price * item.qty).toLocaleString() %></div>
                        </div>
                      <% }) %>
                      <% if (order.items.length > 2) { %>
                        <p style="font-size:0.8125rem;color:var(--color-gray-400);padding:var(--space-2) 0;">+ <%= order.items.length - 2 %> more item(s)</p>
                      <% } %>
                    </div>
                    <div class="account-order-footer" style="display:flex;justify-content:space-between;align-items:center;margin-top:var(--space-4);padding-top:var(--space-4);border-top:1px solid var(--color-gray-200);flex-wrap:wrap;gap:var(--space-3);">
                      <div style="font-size:1.125rem;font-weight:800;">Total: <span>₨<%= order.total.toLocaleString() %></span></div>
                      <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;">
                        <a href="/order/<%= order.orderId %>" class="btn btn-ghost">View Details</a>
                        <a href="/track?order_id=<%= order.orderId %>" class="btn btn-secondary">Track Order</a>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="account-empty">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
                <p>No orders yet. When you place an order, it'll show up here.</p>
                <a href="/shop" class="btn btn-primary">Start Shopping</a>
              </div>
            <% } %>
          <% } else { %>
            <h2>Recent orders</h2>
            <div class="account-empty">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
              <p>Sign in to see your order history.</p>
              <a href="/account?action=login" class="btn btn-primary">Sign In</a>
            </div>
          <% } %>
        </div>

        <!-- Addresses Tab -->
        <div class="account-tab" id="tab-addresses">
          <h2>Saved addresses</h2>
          <% if (user) { %>
            <div class="addresses-section">
              <div class="addresses-list">
                <% if (user.addresses && user.addresses.length > 0) { %>
                  <% user.addresses.forEach((addr, idx) => { %>
                    <div class="address-card">
                      <div class="address-card-header">
                        <span class="address-label"><%= addr.label || 'Address ' + (idx + 1) %></span>
                        <span class="address-default"><%= addr.default ? 'Default' : '' %></span>
                      </div>
                      <div class="address-details">
                        <p><strong><%= addr.name || user.name %></strong></p>
                        <p><%= addr.phone || '' %></p>
                        <p><%= addr.address || '' %></p>
                        <% if (addr.city) { %><p><%= addr.city %><%= addr.state ? ', ' + addr.state : '' %> <%= addr.zip ? ' ' + addr.zip : '' %></p><% } %>
                      </div>
                      <div class="address-actions">
                        <button type="button" class="btn btn-ghost btn-sm" data-copy-address="<%= addr.address %>">Copy</button>
                        <button type="button" class="btn btn-ghost btn-sm text-error" data-remove-index="<%= idx %>">Remove</button>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="address-empty">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <p>No saved addresses yet.</p>
                    <p style="font-size:0.8125rem;color:var(--color-gray-400);margin-top:var(--space-2);">Your addresses are stored in your profile. Add one below to use during checkout.</p>
                  </div>
                <% } %>
              </div>
              <div class="address-form-card">
                <h3><%= user.addresses && user.addresses.length > 0 ? 'Add New Address' : 'Add Your Address' %></h3>
                <form id="address-form" style="margin-top:var(--space-4);">
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4);margin-bottom:var(--space-4);">
                    <div class="form-group" style="grid-column:1/-1;">
                      <label>Address Label (optional)</label>
                      <input type="text" name="label" placeholder="e.g., Home, Office" style="width:100%;" />
                    </div>
                    <div class="form-group">
                      <label>Full Name *</label>
                      <input type="text" name="name" value="<%= user.name %>" required style="width:100%;" />
                    </div>
                    <div class="form-group">
                      <label>Phone *</label>
                      <input type="tel" name="phone" placeholder="+92 300 1234567" required style="width:100%;" />
                    </div>
                    <div class="form-group" style="grid-column:1/-1;">
                      <label>Street Address *</label>
                      <input type="text" name="address" placeholder="House #, Street, Area" required style="width:100%;" />
                    </div>
                    <div class="form-group">
                      <label>City *</label>
                      <input type="text" name="city" placeholder="Karachi, Lahore..." required style="width:100%;" />
                    </div>
                    <div class="form-group">
                      <label>State</label>
                      <input type="text" name="state" placeholder="Sindh, Punjab..." style="width:100%;" />
                    </div>
                    <div class="form-group">
                      <label>Postal Code</label>
                      <input type="text" name="zip" placeholder="74000" style="width:100%;" />
                    </div>
                  </div>
                  <button type="submit" class="btn btn-primary w-100">Save Address</button>
                </form>
              </div>
            </div>
          <% } else { %>
            <div class="account-empty">
              <p>No saved addresses yet.</p>
              <p style="font-size:0.8125rem;color:var(--color-gray-400);margin-top:var(--space-2);">Sign in to save and manage your addresses.</p>
              <a href="/account?action=login" class="btn btn-primary">Sign In</a>
            </div>
          <% } %>
        </div>

        <!-- Settings Tab -->
        <div class="account-tab" id="tab-settings">
          <h2>Account settings</h2>
          <% if (user) { %>
            <div class="account-settings-form">
              <div class="settings-section">
                <h3>Personal Information</h3>
                <div class="form-group">
                  <label>Email</label>
                  <input type="email" value="<%= user.email %>" disabled />
                </div>
                <div class="form-group">
                  <label>Name</label>
                  <input type="text" value="<%= user.name %>" disabled />
                </div>
                <p style="font-size:0.8125rem;color:var(--color-gray-500);margin-bottom:var(--space-4);margin-top:var(--space-2);">
                  To update your email or name, contact <a href="/contact" style="color:var(--color-accent);font-weight:600;">hello@baggy.pk</a>.
                </p>
              </div>

              <div class="settings-section">
                <h3>Change Password</h3>
                <form id="change-password-form" style="margin-top:var(--space-2);" autocomplete="new-password">
                  <div class="form-group">
                    <label for="cp-current">Current password *</label>
                    <input type="password" id="cp-current" name="currentPassword" placeholder="Your current password" required autocomplete="current-password" />
                  </div>
                  <div class="form-group">
                    <label for="cp-new">New password *</label>
                    <input type="password" id="cp-new" name="newPassword" placeholder="At least 8 characters" required minlength="6" maxlength="128" autocomplete="new-password" />
                  </div>
                  <div class="form-group">
                    <label for="cp-confirm">Confirm new password *</label>
                    <input type="password" id="cp-confirm" name="confirmPassword" placeholder="Repeat your new password" required minlength="6" autocomplete="new-password" />
                  </div>
                  <button type="submit" class="btn btn-primary" id="cp-submit" style="margin-top:var(--space-2);">Update Password</button>
                </form>
                <p style="font-size:0.75rem;color:var(--color-gray-400);margin-top:var(--space-2);">
                  Forgot your current password? <a href="/forgot-password" style="color:var(--color-accent);font-weight:600;">Reset it here</a>.
                </p>
              </div>

              <div class="settings-section">
                <h3>Preferences</h3>
                <form id="settings-form" style="margin-top:var(--space-2);">
                  <div class="form-group">
                    <label>Preferred currency</label>
                    <select name="currency" style="width:100%;padding:var(--space-3) var(--space-4);border:1px solid var(--color-gray-300);background:var(--color-white);font-size:0.9375rem;border-radius:2px;">
                      <option value="PKR">PKR — Pakistani Rupee</option>
                      <option value="USD">USD — US Dollar</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label>
                      <input type="checkbox" name="emailNotifications" checked style="width:auto;margin-right:var(--space-2);" />
                      Email notifications
                    </label>
                    <p style="font-size:0.75rem;color:var(--color-gray-400);margin-top:var(--space-1);margin-left:calc(1.25rem + 8px);">Receive order updates and promotional emails.</p>
                  </div>
                  <button type="submit" class="btn btn-primary" style="margin-top:var(--space-4);">Save Preferences</button>
                </form>
              </div>

              <div class="settings-section settings-danger-zone">
                <h3>Danger Zone</h3>
                <p style="font-size:0.8125rem;color:var(--color-gray-500);margin-bottom:var(--space-4);">
                  Once you delete your account, there is no going back. All your orders and wishlist items will be permanently removed.
                </p>
                <button class="btn btn-ghost text-error" id="delete-account-btn" style="margin-top:var(--space-2);">Delete Account</button>
              </div>

              <div class="settings-section" style="margin-top:var(--space-6);padding-top:var(--space-6);border-top:1px solid var(--color-gray-200);">
                <button type="button" class="btn btn-ghost" id="account-logout-btn-2" style="margin-top:0;">Sign Out</button>
              </div>
            </div>
          <% } else { %>
            <div class="account-empty">
              <p>Sign in to manage your account settings.</p>
              <a href="/account?action=login" class="btn btn-primary">Sign In</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Address helper functions
  function copyAddress(address, btn) {
    navigator.clipboard.writeText(address).then(() => {
      btn = btn || event.target;
      const originalText = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => btn.textContent = originalText, 2000);
    }).catch(() => {
      window.showAlert('Could not copy the address. Please copy it manually.', { title: 'Copy Failed', type: 'danger' });
    });
  }

  function removeAddress(idx) {
    window.showConfirm({
      title: 'Remove this address?',
      message: 'It will be deleted from your saved addresses.',
      confirmText: 'Remove',
      icon: 'warning'
    }).then(ok => {
      if (!ok) return;
      fetch('/api/user/addresses', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ index: idx })
      }).then(res => res.json()).then(data => {
        if (data.ok) {
          // Refresh the page to show updated addresses
          window.location.reload();
        } else {
          window.showAlert(data.message || 'Failed to remove address', { title: 'Something went wrong', type: 'danger' });
        }
      }).catch(() => {
        window.showAlert('Network error — please check your connection and try again.', { title: 'Connection Problem', type: 'danger' });
      });
    });
  }

  // Address form submission
  document.getElementById('address-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = new FormData(form);
    const address = {
      label: data.get('label')?.trim() || '',
      name: data.get('name')?.trim(),
      phone: data.get('phone')?.trim(),
      address: data.get('address')?.trim(),
      city: data.get('city')?.trim(),
      state: data.get('state')?.trim(),
      zip: data.get('zip')?.trim(),
      default: <%= user && user.addresses ? user.addresses.length : 0 %> === 0
    };
    try {
      const res = await fetch('/api/user/addresses', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(address)
      });
      const result = await res.json();
      if (result.ok) {
        window.location.reload();
      } else {
        window.showAlert(result.message || 'Please check the form and try again.', { title: 'Could Not Save Address', type: 'danger' });
      }
    } catch {
      window.showAlert('Network error — please check your connection and try again.', { title: 'Connection Problem', type: 'danger' });
    }
  });

  // Change password submission
  document.getElementById('change-password-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = new FormData(form);
    const currentPassword = data.get('currentPassword');
    const newPassword = data.get('newPassword');
    const confirmPassword = data.get('confirmPassword');
    if (newPassword !== confirmPassword) {
      window.showAlert('The new passwords you entered do not match. Please retype them.', { title: 'Passwords Don\'t Match', type: 'warning' });
      return;
    }
    const btn = document.getElementById('cp-submit');
    btn.disabled = true;
    btn.textContent = 'Updating...';
    try {
      const res = await fetch('/api/user/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword })
      });
      const result = await res.json();
      if (result.ok) {
        showToast('Password changed successfully');
        form.reset();
      } else {
        window.showAlert(result.message || 'Please try again.', { title: 'Could Not Update Password', type: 'danger' });
      }
    } catch {
      window.showAlert('Network error — please check your connection and try again.', { title: 'Connection Problem', type: 'danger' });
    } finally {
      btn.disabled = false;
      btn.textContent = 'Update Password';
    }
  });

  // Settings form submission
  document.getElementById('settings-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = new FormData(form);
    const preferences = {
      currency: data.get('currency'),
      emailNotifications: data.get('emailNotifications') === 'on'
    };
    try {
      const res = await fetch('/api/user/settings', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(preferences)
      });
      const result = await res.json();
      if (result.ok) {
        showToast('Settings saved successfully');
      } else {
        window.showAlert(result.message || 'Please try again.', { title: 'Could Not Save Settings', type: 'danger' });
      }
    } catch {
      window.showAlert('Network error — please check your connection and try again.', { title: 'Connection Problem', type: 'danger' });
    }
  });

  // Delete account confirmation
  document.getElementById('delete-account-btn')?.addEventListener('click', async () => {
    const first = await window.showConfirm({
      title: 'Delete your account?',
      message: 'This action cannot be undone. All your orders and wishlist items will be permanently removed.',
      confirmText: 'Delete Account',
      cancelText: 'Keep Account',
      icon: 'danger'
    });
    if (!first) return;
    const second = await window.showConfirm({
      title: 'Are you absolutely sure?',
      message: 'This will permanently delete your account, all orders, and wishlist items.',
      confirmText: 'Yes, Delete Everything',
      cancelText: 'Cancel',
      icon: 'danger'
    });
    if (!second) return;
    fetch('/api/auth/logout', { method: 'POST' }).then(() => {
      window.location.href = '/';
    });
  });
</script>


