<header class="page-header">
  <div class="container">
    <h1 class="page-title page-title-animated" data-split-text>ORDERS</h1>
    <p class="page-desc" data-reveal>View & manage customer orders</p>
  </div>
</header>

<section class="section admin-section">
  <div class="container">
    <div class="admin-layout" style="padding-top:0;">
      <aside class="admin-sidebar" data-reveal>
        <div class="admin-brand">
          <a href="/" class="admin-brand-link">BA GGY</a>
        </div>
        <nav class="admin-nav">
          <a href="/admin">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Dashboard
          </a>
          <a href="/admin/orders" class="active">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            Orders
            <% if (total > 0) { %><span class="admin-nav-badge"><%= total %></span><% } %>
          </a>
          <a href="/admin/products">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            Products
          </a>
          <a href="/admin/contacts"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Messages
          </a>
        </nav>
        <div class="admin-sidebar-footer">
          <a href="/" class="admin-view-store" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            View Store
          </a>
          <form action="/api/auth/logout" method="POST" style="margin-top:var(--space-4);">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="admin-logout-btn">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Sign Out
            </button>
          </form>
        </div>
      </aside>

      <div class="admin-content" data-reveal style="transition-delay: 0.1s">
        <div class="admin-bar">
          <div class="admin-bar-left">
            <h2>All Orders</h2>
            <p class="admin-sub" style="margin-bottom:0;"><%= total %> order(s) <%= statusFilter ? '(' + statusFilter + ')' : '' %></p>
          </div>
          <div class="admin-bar-right">
            <div class="form-group" style="margin-bottom:0;">
              <label for="order-status-filter" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">Filter by status</label>
              <select id="order-status-filter" class="search-input" style="height:42px;">
                <option value="" <%= !statusFilter ? 'selected' : '' %>>All statuses</option>
                <% ['pending','confirmed','processing','shipped','delivered','cancelled'].forEach(s => { %>
                  <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <% if (orders && orders.length > 0) { %>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Customer</th>
                  <th>Items</th>
                  <th>Total</th>
                  <th>Status</th>
                  <th>Placed</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% orders.forEach(order => { %>
                  <tr>
                    <td>
                      <strong style="font-family:var(--font-mono);"><%= order.orderId %></strong>
                    </td>
                    <td>
                      <strong><%= order.customer.name %></strong>
                      <span style="font-size:0.8125rem;color:var(--color-gray-500);"><%= order.customer.email %></span>
                    </td>
                    <td>
                      <% order.items.slice(0, 2).forEach(item => { %>
                        <div style="display:flex; align-items:center; gap:var(--space-2); margin-bottom:4px;">
                          <img src="<%= imgUrl(item.image) %>" alt="" class="admin-img" style="width:36px;height:36px;" />
                          <div>
                            <strong style="font-size:0.8125rem;"><%= item.name %></strong>
                            <span style="font-size:0.75rem;color:var(--color-gray-400);">×<%= item.qty %></span>
                          </div>
                        </div>
                      <% }) %>
                      <% if (order.items.length > 2) { %>
                        <span style="font-size:0.75rem;color:var(--color-gray-400);">+<%= order.items.length - 2 %> more</span>
                      <% } %>
                    </td>
                    <td style="font-weight:700;">₨<%= order.total.toLocaleString() %></td>
                    <td>
                      <span class="status-badge status-<%= order.status %>"><%= order.status %></span>
                    </td>
                    <td style="color:var(--color-gray-500);font-size:0.8125rem;">
                      <%= order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-PK', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %>
                    </td>
                    <td>
                      <div class="admin-actions">
                        <a href="/admin/order/<%= order.orderId %>" class="admin-btn">View</a>
                        <button class="admin-btn status-picker" data-order-id="<%= order.orderId %>" data-current-status="<%= order.status %>">Change</button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="admin-pagination">
            <div class="pagination-info">
              Showing page <%= page %> of <%= totalPages || 1 %>
            </div>
            <div class="pagination-controls">
              <button class="pagination-btn" data-page="prev" <%= page <= 1 ? 'disabled' : '' %>>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <% for (let p = 1; p <= (totalPages || 1); p++) { %>
                <button class="pagination-btn <%= p === page ? 'active' : '' %>" data-page="<%= p %>"><%= p %></button>
              <% } %>
              <button class="pagination-btn" data-page="next" <%= page >= (totalPages || 1) ? 'disabled' : '' %>>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
          </div>
        <% } else { %>
          <div class="admin-empty">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <h3>No orders yet</h3>
            <p>Orders will appear here once customers start purchasing.</p>
            <a href="/shop" class="btn btn-primary">Visit Store</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- Status picker modal -->
<div class="admin-modal" id="status-modal" role="dialog" aria-modal="true" aria-labelledby="status-modal-title">
  <div class="admin-modal-card">
    <button class="admin-modal-close" id="status-modal-close" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3 id="status-modal-title">Change Order Status</h3>
    <p class="admin-modal-sub" id="status-modal-sub"></p>
    <form id="status-form">
      <input type="hidden" name="orderId" id="status-order-id" />
      <div class="form-group">
        <label for="status-select">New status</label>
        <select id="status-select" name="status" required>
          <option value="pending">Pending</option>
          <option value="confirmed">Confirmed</option>
          <option value="processing">Processing</option>
          <option value="shipped">Shipped</option>
          <option value="delivered">Delivered</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </div>
      <div class="admin-modal-actions">
        <button type="button" class="admin-btn" id="status-cancel">Cancel</button>
        <button type="submit" class="admin-btn primary">Update Status</button>
      </div>
    </form>
    <div id="status-error" class="auth-error" style="display:none;margin-top:var(--space-4);"></div>
  </div>
</div>

<script>
  // ─── Toast Notification ─────────────────────────────────────────
  function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.style.cssText = `
      position:fixed;bottom:20px;right:20px;padding:16px 24px;
      border-radius:8px;background:${type === 'error' ? '#dc2626' : '#16a34a'};
      color:white;font-weight:500;box-shadow:0 10px 25px -5px rgba(0,0,0,0.2);
      z-index:10000;animation:slideIn 0.3s ease;
    `;
    toast.textContent = message;
    document.body.appendChild(toast);

    if (!document.querySelector('style[data-toast-keyframes]')) {
      const style = document.createElement('style');
      style.dataset.toastKeyframes = true;
      style.textContent = `
        @keyframes slideIn {
          from { transform: translateX(100%); opacity: 0; }
          to { transform: translateX(0); opacity: 1; }
        }
      `;
      document.head.appendChild(style);
    }

    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transition = 'opacity 0.3s';
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  // ─── Status Modal Handlers ──────────────────────────────────────
  document.querySelectorAll('.status-picker').forEach(btn => {
    btn.addEventListener('click', () => {
      const orderId = btn.dataset.orderId;
      const currentStatus = btn.dataset.currentStatus;
      document.getElementById('status-order-id').value = orderId;
      document.getElementById('status-select').value = currentStatus;
      document.getElementById('status-modal').classList.add('open');
    });
  });

  document.getElementById('status-modal-close')?.addEventListener('click', () => {
    document.getElementById('status-modal').classList.remove('open');
  });

  document.getElementById('status-cancel')?.addEventListener('click', () => {
    document.getElementById('status-modal').classList.remove('open');
  });

  document.getElementById('status-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('status-modal')) {
      document.getElementById('status-modal').classList.remove('open');
    }
  });

  document.getElementById('status-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const orderId = document.getElementById('status-order-id').value;
    const newStatus = document.getElementById('status-select').value;
    const submitBtn = e.target.querySelector('button[type="submit"]');

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<svg class="spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><circle cx="12" cy="12" r="10"/></svg> Updating...';

    try {
      const res = await fetch(`/admin/order/${orderId}/status`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.body.dataset.csrf
        },
        body: JSON.stringify({ status: newStatus })
      });

      const data = await res.json();
      if (data.ok) {
        showToast('Order status updated!', 'success');
        document.getElementById('status-modal').classList.remove('open');
        setTimeout(() => window.location.reload(), 1000);
      } else {
        document.getElementById('status-error').textContent = data.message || 'Failed to update status';
        document.getElementById('status-error').style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Update Status';
      }
    } catch (err) {
      document.getElementById('status-error').textContent = 'Network error: ' + err.message;
      document.getElementById('status-error').style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Update Status';
    }
  });

  // ─── Status Modal: Close on Escape ──────────────────────────────
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.getElementById('status-modal')?.classList.contains('open')) {
      document.getElementById('status-modal').classList.remove('open');
    }
  });

  // ─── Pagination Handlers ────────────────────────────────────────
  document.querySelectorAll('.pagination-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const page = btn.dataset.page;
      if (page === 'prev') {
        const currentPage = parseInt(document.querySelector('.pagination-info').textContent.match(/page (\d+)/)?.[1] || '1');
        window.location.href = `/admin/orders?page=${Math.max(1, currentPage - 1)}${window.location.search.includes('status=') ? '&status=' + new URLSearchParams(window.location.search).get('status') : ''}`;
      } else if (page === 'next') {
        const totalPages = parseInt(window.location.href.includes('page') ? document.querySelector('.pagination-info').textContent.match(/of (\d+)/)?.[1] || '1' : '1');
        window.location.href = `/admin/orders?page=${parseInt(document.querySelector('.pagination-info').textContent.match(/page (\d+)/)?.[1] || '1') + 1}${window.location.search.includes('status=') ? '&status=' + new URLSearchParams(window.location.search).get('status') : ''}`;
      } else {
        window.location.href = `/admin/orders?page=${page}${window.location.search.includes('status=') ? '&status=' + new URLSearchParams(window.location.search).get('status') : ''}`;
      }
    });
  });

  // ─── Status Filter Change ───────────────────────────────────────
  document.getElementById('order-status-filter')?.addEventListener('change', (e) => {
    const status = e.target.value;
    window.location.href = `/admin/orders${status ? '?status=' + status : ''}`;
  });
</script>




