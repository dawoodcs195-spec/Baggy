<header class="page-header">
  <div class="container">
    <h1 class="page-title page-title-animated" data-split-text>PRODUCTS</h1>
    <p class="page-desc" data-reveal>Manage your catalog</p>
  </div>
</header>

<section class="section admin-section">
  <div class="container">
    <div class="admin-layout" style="padding-top:0;">
      <aside class="admin-sidebar" data-reveal>
        <div class="admin-brand">
          <a href="/" class="admin-brand-link">BA GGY</a>
        </div>
        <nav class="admin-nav">
          <a href="/admin">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            Dashboard
          </a>
          <a href="/admin/orders">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            Orders
            <% if (typeof totalOrders !== 'undefined' && totalOrders > 0) { %><span class="admin-nav-badge"><%= totalOrders %></span><% } %>
          </a>
          <a href="/admin/products" class="active">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            Products
            <% if (typeof total !== 'undefined' && total > 0) { %><span class="admin-nav-badge"><%= total %></span><% } %>
          </a>
          <a href="/admin/contacts"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Messages
          </a>
          <a href="/admin/newsletter">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Newsletter
          </a>
        </nav>
        <div class="admin-sidebar-footer">
          <a href="/" class="admin-view-store" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            View Store
          </a>
          <form action="/api/auth/logout" method="POST" style="margin-top:var(--space-4);">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="admin-logout-btn">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              Sign Out
            </button>
          </form>
        </div>
      </aside>

      <div class="admin-content" data-reveal style="transition-delay: 0.1s">
        <div class="admin-bar">
          <div class="admin-bar-left">
            <h2>All Products</h2>
            <p class="admin-sub" style="margin-bottom:0;"><%= total %> product(s) in catalog</p>
          </div>
          <div class="admin-bar-right">
            <button class="btn btn-primary" id="add-product-btn">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Add Product
            </button>
            <div class="live-search-wrap">
              <label for="admin-live-search" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">Search products</label>
              <input type="text" id="admin-live-search" placeholder="Search products..." class="search-input" autocomplete="off" />
              <span id="admin-search-count" style="font-size:0.8125rem;color:var(--color-gray-400);align-self:center;"></span>
            </div>
          </div>
        </div>

        <% if (products && products.length > 0) { %>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Category</th>
                  <th>Price</th>
                  <th>Stock</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% products.forEach(product => { %>
                  <tr>
                    <td>
                      <div style="display:flex;align-items:center;gap:var(--space-3);">
                        <img src="<%= imgUrl(product.images && product.images[0]) %>" alt="" class="admin-img" loading="lazy" decoding="async" style="width:48px;height:48px;object-fit:cover;border-radius:2px;" />
                        <div>
                          <strong style="font-size:0.9375rem;"><%= product.name %></strong>
                          <span style="font-size:0.75rem;color:var(--color-gray-400);display:block;"><%= product.subcategory %></span>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span style="text-transform:capitalize;"><%= product.category %></span>
                      <span style="color:var(--color-gray-300);">/</span>
                      <span style="text-transform:capitalize;color:var(--color-gray-500);font-size:0.8125rem;"><%= product.subcategory %></span>
                    </td>
                    <td style="font-weight:700;">₨<%= product.price.toLocaleString() %></td>
                    <td>
                      <span class="stock-badge <%= product.stock > 10 ? 'in-stock' : product.stock > 0 ? 'low-stock' : 'out-of-stock' %>">
                        <%= product.stock %>
                      </span>
                    </td>
                    <td>
                      <div class="product-toggles">
                        <label class="admin-toggle">
                          <span>Featured</span>
                          <input type="checkbox" class="product-toggle" data-product-id="<%= product.id %>" data-field="featured" <%= product.featured ? 'checked' : '' %> />
                          <span class="toggle-slider"></span>
                        </label>
                        <label class="admin-toggle">
                          <span>Active</span>
                          <input type="checkbox" class="product-toggle" data-product-id="<%= product.id %>" data-field="active" <%= product.active !== false ? 'checked' : '' %> />
                          <span class="toggle-slider"></span>
                        </label>
                      </div>
                    </td>
                    <td>
                      <div class="admin-actions">
                        <button class="admin-btn" data-product-id="<%= product.id %>" data-edit-btn>Edit</button>
                        <a href="/product/<%= product.id %>" class="admin-btn" target="_blank" rel="noopener">View</a>
                        <button class="admin-btn text-error" data-product-id="<%= product.id %>" data-delete-btn>Delete</button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="admin-pagination">
            <div class="pagination-info">
              Showing page <%= page %> of <%= totalPages || 1 %>
            </div>
            <div class="pagination-controls">
              <button class="pagination-btn" data-page="prev" <%= page <= 1 ? 'disabled' : '' %>>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <% for (let p = 1; p <= (totalPages || 1); p++) { %>
                <button class="pagination-btn <%= p === page ? 'active' : '' %>" data-page="<%= p %>"><%= p %></button>
              <% } %>
              <button class="pagination-btn" data-page="next" <%= page >= (totalPages || 1) ? 'disabled' : '' %>>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            </div>
          </div>
        <% } else { %>
          <div class="admin-empty">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            <h3>No products found</h3>
            <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
              <p>No products match "<%= searchQuery %>".</p>
            <% } else { %>
              <p>Your catalog is empty. Add your first product below.</p>
            <% } %>
            <button class="btn btn-primary" id="add-product-btn-empty">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Add First Product
            </button>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- Add/Edit Product Modal -->
<div class="admin-modal" id="product-modal" role="dialog" aria-modal="true" aria-labelledby="product-modal-title">
  <div class="admin-modal-card admin-product-modal">
    <button class="admin-modal-close" id="product-modal-close" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3 id="product-modal-title">Add Product</h3>
    <p class="admin-modal-sub" id="product-modal-sub">Fill in the product details below</p>

    <form id="product-form" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="productId" id="edit-product-id" />

      <div class="form-group">
        <label for="product-name">Product Name *</label>
        <input type="text" id="product-name" name="name" required placeholder="e.g., Baggy Jeans - Black" />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="product-category">Category *</label>
          <select id="product-category" name="category" required>
            <option value="">Select category</option>
            <option value="jeans">Jeans</option>
            <option value="shirts">Shirts</option>
            <option value="accessories">Accessories</option>
            <option value="uppers">Uppers</option>
          </select>
        </div>
        <div class="form-group">
          <label for="product-subcategory">Subcategory *</label>
          <input type="text" id="product-subcategory" name="subcategory" required placeholder="e.g., Baggy, Slim, Oversized" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="product-price">Price (PKR) *</label>
          <input type="number" id="product-price" name="price" required min="1" placeholder="e.g., 2499" />
        </div>
        <div class="form-group">
          <label for="product-original-price">Original Price (PKR)</label>
          <input type="number" id="product-original-price" name="originalPrice" min="1" placeholder="e.g., 3499" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="product-stock">Stock *</label>
          <input type="number" id="product-stock" name="stock" required min="0" placeholder="e.g., 50" />
        </div>
        <div class="form-group">
          <label for="product-rating">Rating</label>
          <input type="number" id="product-rating" name="rating" min="0" max="5" step="0.1" placeholder="4.5" />
        </div>
      </div>

      <div class="form-group">
        <label for="product-colors">Colors (comma-separated) *</label>
        <input type="text" id="product-colors" name="colors" required placeholder="e.g., Black, Blue, Grey" />
      </div>

      <div class="form-group">
        <label for="product-sizes">Sizes (comma-separated) *</label>
        <input type="text" id="product-sizes" name="sizes" required placeholder="e.g., S, M, L, XL" />
      </div>

      <div class="form-group">
        <label for="product-images">Product Images</label>
        <div class="file-upload-area" id="file-upload-area">
          <input type="file" id="product-images" name="images" multiple accept="image/*" style="display:none;" />
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width:32px;height:32px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <p>Click to upload product images (up to 5)</p>
          <span style="font-size:0.8125rem;color:var(--color-gray-400);">PNG, JPG up to 5MB each</span>
        </div>
        <div class="file-preview" id="file-preview"></div>
      </div>

      <div class="form-group">
        <label for="product-description">Description</label>
        <textarea id="product-description" name="description" rows="4" placeholder="Product description..."></textarea>
      </div>

      <div class="form-group">
        <label for="product-details">Details (one per line)</label>
        <textarea id="product-details" name="details" rows="3" placeholder="100% Cotton&#10;Machine washable&#10;Pre-washed"></textarea>
      </div>

      <div class="form-group">
        <label for="product-care">Care Instructions (one per line)</label>
        <textarea id="product-care" name="care" rows="3" placeholder="Cold wash&#10;Tumble dry low&#10;Iron on low heat"></textarea>
      </div>

      <div class="form-row form-row-toggles">
        <label class="admin-toggle-large">
          <input type="checkbox" name="featured" />
          <span class="toggle-slider"></span>
          <span class="toggle-label">Featured Product</span>
        </label>
        <label class="admin-toggle-large">
          <input type="checkbox" name="newArrival" />
          <span class="toggle-slider"></span>
          <span class="toggle-label">New Arrival</span>
        </label>
      </div>

      <div class="admin-modal-actions">
        <button type="button" class="admin-btn" id="product-form-cancel">Cancel</button>
        <button type="submit" class="admin-btn primary">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><polyline points="20 6 9 17 4 12"/></svg>
          <span id="product-form-submit-text">Add Product</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Product Quick View Modal -->
<div class="admin-modal" id="product-quick-modal" role="dialog" aria-modal="true" aria-labelledby="product-quick-title">
  <div class="admin-modal-card">
    <button class="admin-modal-close" id="product-quick-close" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <h3 id="product-quick-title">Product Details</h3>
    <div id="product-quick-body"></div>
  </div>
</div>

<script>
  // Toast helper (self-contained for admin pages)
  function showToast(message, type = 'success') {
    const existing = document.querySelector('.toast-container');
    if (existing) existing.remove();
    const container = document.createElement('div');
    container.className = 'toast-container';
    container.setAttribute('role', 'status');
    container.setAttribute('aria-live', 'polite');
    container.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none;';
    const toast = document.createElement('div');
    toast.className = 'toast toast-' + type;
    toast.style.cssText = 'background:' + (type === 'success' ? '#0a0a0a' : '#b8002f') + ';color:#fff;padding:14px 20px;border-radius:4px;font-size:0.875rem;font-weight:600;letter-spacing:0.03em;box-shadow:0 8px 24px rgba(0,0,0,0.18);display:flex;align-items:center;gap:10px;pointer-events:auto;animation:toastIn 0.35s ease both;';
    toast.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (type === 'success' ? '<polyline points="20 6 9 17 4 12"/>' : '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>') + '</svg><span>' + message + '</span>';
    container.appendChild(toast);
    document.body.appendChild(container);
    if (!document.getElementById('toast-animations')) {
      const s = document.createElement('style');
      s.id = 'toast-animations';
      s.textContent = '@keyframes toastIn { from { opacity:0; transform:translateX(40px); } to { opacity:1; transform:translateX(0); } } @keyframes toastOut { from { opacity:1; transform:translateX(0); } to { opacity:0; transform:translateX(40px); } }';
      document.head.appendChild(s);
    }
    setTimeout(() => { toast.style.animation = 'toastOut 0.3s ease forwards'; setTimeout(() => container.remove(), 300); }, 2800);
  }

  // Expose to window for reliability
  window.showToast = showToast;

  // Product modal handling
  let currentEditProductId = null;

  const productModal = document.getElementById('product-modal');
  const productForm = document.getElementById('product-form');
  const productNameInput = document.getElementById('product-name');
  const editProductIdInput = document.getElementById('edit-product-id');
  const submitText = document.getElementById('product-form-submit-text');

  // Open modal for adding new product
  function openAddProductModal() {
    currentEditProductId = null;
    productModal.querySelector('#product-modal-title').textContent = 'Add Product';
    productModal.querySelector('#product-modal-sub').textContent = 'Fill in the product details below';
    productForm.reset();
    imageState.existing = [];
    imageState.files = [];
    renderImagePreviews();
    editProductIdInput.value = '';
    submitText.textContent = 'Add Product';
    document.querySelector('#product-form input[name="featured"]').checked = false;
    document.querySelector('#product-form input[name="newArrival"]').checked = false;
    productModal.classList.add('open');
    setTimeout(() => productNameInput?.focus(), 100);
  }

  // Open modal for editing existing product
  async function openEditProductModal(productId) {
    try {
      const res = await fetch(`/api/admin/product/${productId}`);
      if (!res.ok) {
        showToast('Failed to load product', 'error');
        return;
      }
      const product = await res.json();
      if (!product) {
        showToast('Product not found', 'error');
        return;
      }

      currentEditProductId = productId;
      productModal.querySelector('#product-modal-title').textContent = 'Edit Product';
      productModal.querySelector('#product-modal-sub').textContent = 'Update product details';
      editProductIdInput.value = productId;
      submitText.textContent = 'Save Changes';

      productNameInput.value = product.name || '';
      document.getElementById('product-category').value = product.category || 'jeans';
      document.getElementById('product-subcategory').value = product.subcategory || '';
      document.getElementById('product-price').value = product.price || '';
      document.getElementById('product-original-price').value = product.originalPrice || '';
      document.getElementById('product-stock').value = product.stock || '';
      document.getElementById('product-rating').value = product.rating || '';
      document.getElementById('product-colors').value = (product.colors || []).join(', ');
      document.getElementById('product-sizes').value = (product.sizes || []).join(', ');
      document.getElementById('product-description').value = product.description || '';
      document.getElementById('product-details').value = (product.details || []).join('\n');
      document.getElementById('product-care').value = (product.care || []).join('\n');
      document.querySelector('#product-form input[name="featured"]').checked = product.featured || false;
      document.querySelector('#product-form input[name="newArrival"]').checked = product.newArrival || false;

      // Load the product's existing images so they can be viewed or removed
      imageState.existing = (product.images || []).map(u => String(u)).filter(Boolean);
      imageState.files = [];
      renderImagePreviews();

      productModal.classList.add('open');
    } catch (err) {
      showToast('Error loading product: ' + err.message, 'error');
    }
  }

  // ── Image preview state (existing Cloudinary images + newly picked files) ──
  const imageState = { existing: [], files: [] };

  function renderImagePreviews() {
    const preview = document.getElementById('file-preview');
    if (!preview) return;
    preview.innerHTML = '';
    const removeSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
    imageState.existing.forEach((url, i) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'file-preview-item';
      wrapper.innerHTML =
        '<img src="' + url + '" alt="Image ' + (i + 1) + '" />' +
        '<button type="button" class="file-preview-remove" data-kind="existing" data-index="' + i + '" aria-label="Remove image">' + removeSvg + '</button>';
      preview.appendChild(wrapper);
    });
    imageState.files.forEach((file, i) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'file-preview-item';
      wrapper.innerHTML =
        '<img src="' + URL.createObjectURL(file) + '" alt="New image ' + (i + 1) + '" />' +
        '<button type="button" class="file-preview-remove" data-kind="new" data-index="' + i + '" aria-label="Remove image">' + removeSvg + '</button>';
      preview.appendChild(wrapper);
    });
  }

  function syncFileInput() {
    const input = document.getElementById('product-images');
    if (!input) return;
    const dt = new DataTransfer();
    imageState.files.forEach(f => dt.items.add(f));
    input.files = dt.files;
  }

  // Delegated remove handler — always current, works for existing and new images
  document.getElementById('file-preview')?.addEventListener('click', (e) => {
    const btn = e.target.closest('.file-preview-remove');
    if (!btn) return;
    const idx = parseInt(btn.dataset.index, 10);
    if (btn.dataset.kind === 'existing') {
      imageState.existing.splice(idx, 1);
    } else {
      imageState.files.splice(idx, 1);
      syncFileInput();
    }
    renderImagePreviews();
  });

  document.getElementById('file-upload-area')?.addEventListener('click', () => {
    document.getElementById('product-images')?.click();
  });

  document.getElementById('product-images')?.addEventListener('change', (e) => {
    const picked = Array.from(e.target.files || []);
    e.target.value = ''; // imageState below owns the input from here on
    const room = 5 - (imageState.existing.length + imageState.files.length);
    if (picked.length > room) showToast('You can have up to 5 images total', 'error');
    imageState.files = imageState.files.concat(picked.slice(0, Math.max(0, room)));
    syncFileInput();
    renderImagePreviews();
  });

  // Form submit
  productForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);

    // Parse arrays from comma-separated inputs
    const colors = formData.get('colors')?.split(',').map(c => c.trim()).filter(Boolean) || [];
    const sizes = formData.get('sizes')?.split(',').map(s => s.trim()).filter(Boolean) || [];
    const details = formData.get('details')?.split('\n').map(d => d.trim()).filter(Boolean) || [];
    const care = formData.get('care')?.split('\n').map(c => c.trim()).filter(Boolean) || [];

    const productData = {
      name: formData.get('name'),
      category: formData.get('category'),
      subcategory: formData.get('subcategory'),
      price: parseFloat(formData.get('price')),
      originalPrice: parseFloat(formData.get('originalPrice')) || undefined,
      stock: parseInt(formData.get('stock')),
      rating: parseFloat(formData.get('rating')) || undefined,
      colors,
      sizes,
      images: [],
      description: formData.get('description'),
      details,
      care,
      featured: formData.get('featured') === 'on',
      newArrival: formData.get('newArrival') === 'on',
      active: true
    };

    const editId = editProductIdInput.value;
    const submitBtn = form.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<svg class="spin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><circle cx="12" cy="12" r="10"/></svg> Saving...';

    try {
      const url = editId ? `/api/admin/product/${editId}` : '/api/admin/products';
      const method = editId ? 'PUT' : 'POST';

      // Create FormData for file uploads
      const uploadFormData = new FormData();

      // Add text fields
      uploadFormData.append('_csrf', formData.get('_csrf')); // Ensure CSRF token is included
      uploadFormData.append('name', productData.name);
      uploadFormData.append('category', productData.category);
      uploadFormData.append('subcategory', productData.subcategory);
      uploadFormData.append('price', productData.price);
      if (productData.originalPrice) uploadFormData.append('originalPrice', productData.originalPrice);
      uploadFormData.append('stock', productData.stock);
      if (productData.rating) uploadFormData.append('rating', productData.rating);
      uploadFormData.append('colors', productData.colors.join(','));
      uploadFormData.append('sizes', productData.sizes.join(','));
      uploadFormData.append('description', productData.description);
      uploadFormData.append('details', productData.details.join('\n'));
      uploadFormData.append('care', productData.care.join('\n'));
      uploadFormData.append('featured', productData.featured);
      uploadFormData.append('newArrival', productData.newArrival);
      uploadFormData.append('active', productData.active);

      // Send the kept existing images so removals take effect on the server
      if (editId) {
        if (imageState.existing.length > 0) {
          imageState.existing.forEach(u => uploadFormData.append('existingImages', u));
        } else {
          uploadFormData.append('imagesCleared', 'true');
        }
      }

      // Add image files if any
      const imageInput = document.getElementById('product-images');
      if (imageInput && imageInput.files.length > 0) {
        for (let i = 0; i < imageInput.files.length; i++) {
          uploadFormData.append('images', imageInput.files[i]);
        }
      }

      const res = await fetch(url, {
        method,
        body: uploadFormData
      });

      const data = await res.json();
      if (data.ok) {
        showToast(editId ? 'Product updated!' : 'Product added!', 'success');
        productModal.classList.remove('open');
        setTimeout(() => window.location.reload(), 500);
      } else {
        showToast(data.message || 'Failed to save product', 'error');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span id="product-form-submit-text">' + (editId ? 'Save Changes' : 'Add Product') + '</span>';
      }
    } catch (err) {
      console.error('Update error:', err);
      showToast('Network error: ' + err.message, 'error');
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span id="product-form-submit-text">' + (editId ? 'Save Changes' : 'Add Product') + '</span>';
    }
  });

  // Cancel button
  document.getElementById('product-form-cancel')?.addEventListener('click', () => {
    productModal.classList.remove('open');
  });

  // Close modal
  document.getElementById('product-modal-close')?.addEventListener('click', () => {
    productModal.classList.remove('open');
  });

  // Close on overlay click
  productModal?.addEventListener('click', (e) => {
    if (e.target === productModal) {
      productModal.classList.remove('open');
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && productModal?.classList.contains('open')) {
      productModal.classList.remove('open');
    }
  });

  // Wire up buttons
  document.getElementById('add-product-btn')?.addEventListener('click', openAddProductModal);
  document.getElementById('add-product-btn-empty')?.addEventListener('click', openAddProductModal);

  // Edit buttons (delegated)
  document.querySelector('.admin-table-wrap')?.addEventListener('click', (e) => {
    const editBtn = e.target.closest('[data-edit-btn]');
    if (editBtn) {
      const productId = editBtn.dataset.productId;
      if (productId) openEditProductModal(productId);
    }
  });

  // Delete product (delegated so it works on every page)
  document.querySelector('.admin-table-wrap')?.addEventListener('click', async (e) => {
    const delBtn = e.target.closest('[data-delete-btn]');
    if (!delBtn) return;
    const productId = delBtn.dataset.productId;
    if (!productId) return;
    const ok = await window.showConfirm({
      title: 'Delete this product?',
      message: 'It will be permanently removed from your store. This cannot be undone.',
      confirmText: 'Delete Product',
      icon: 'danger'
    });
    if (!ok) return;
    try {
      const res = await fetch(`/api/admin/product/${productId}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.ok) {
        showToast('Product deleted');
        delBtn.closest('tr')?.remove();
        setTimeout(() => window.location.reload(), 600);
      } else {
        showToast(data.message || 'Failed to delete', 'error');
      }
    } catch {
      showToast('Network error', 'error');
    }
  });

  // Toggle switches for quick status changes
  document.querySelectorAll('.product-toggle').forEach(toggle => {
    toggle.addEventListener('change', async (e) => {
      const productId = toggle.dataset.productId;
      const field = toggle.dataset.field;
      const value = e.target.checked;

      try {
        const res = await fetch(`/api/admin/product/${productId}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ [field]: value })
        });
        const data = await res.json();
        if (!data.ok) {
          toggle.checked = !value; // Revert
          showToast('Failed to update', 'error');
        }
      } catch {
        toggle.checked = !value;
        showToast('Network error', 'error');
      }
    });
  });

</script>




