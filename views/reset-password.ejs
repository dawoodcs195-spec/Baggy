<div class="auth-page">
  <div class="container">
    <div class="auth-layout">
      <div class="auth-visual">
        <img src="/public/images/b2.jpg" alt="" loading="lazy" />
        <div class="auth-visual-content">
          <div class="auth-brand">BA GGY</div>
          <p class="auth-eyebrow">New Password</p>
          <p class="auth-quote">Fashion that moves with you.</p>
        </div>
      </div>

      <div class="auth-form-card" data-reveal>
        <h2 data-split-text>Reset Password</h2>
        <p class="auth-sub">Choose a new password for your account.</p>

        <div id="rp-error" class="auth-error hidden"></div>
        <div id="rp-success" class="auth-success hidden"></div>

        <% if (!resetToken || !resetEmail) { %>
          <p class="auth-note">
            This link is missing its reset details. Please request a fresh link from the
            <a href="/forgot-password">forgot password page</a>.
          </p>
        <% } else { %>
        <form id="reset-form" autocomplete="on">
          <div class="form-group">
            <label for="rp-password">New password *</label>
            <input type="password" id="rp-password" name="password" placeholder="At least 8 characters" required minlength="8" maxlength="128" autocomplete="new-password" />
            <div class="pw-meter"><div class="pw-meter-bar" id="rp-pw-bar"></div></div>
            <p class="pw-hint" id="rp-pw-hint" role="status"></p>
          </div>
          <div class="form-group">
            <label for="rp-password2">Confirm new password *</label>
            <input type="password" id="rp-password2" name="password2" placeholder="Repeat your new password" required minlength="8" autocomplete="new-password" />
          </div>
          <button type="submit" class="btn btn-primary w-100" id="rp-submit">Set New Password</button>
        </form>
        <% } %>

        <p class="auth-footer-link">
          <a href="/account?action=login">Back to sign in</a>
        </p>
      </div>
    </div>
  </div>
</div>

<% if (resetToken && resetEmail) { %>
<script>
  document.getElementById('reset-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errBox = document.getElementById('rp-error');
    const okBox = document.getElementById('rp-success');
    errBox.classList.add('hidden');
    okBox.classList.add('hidden');
    const password = document.getElementById('rp-password').value;
    const password2 = document.getElementById('rp-password2').value;
    if (password !== password2) {
      errBox.textContent = 'Passwords do not match';
      errBox.classList.remove('hidden');
      return;
    }
    const btn = document.getElementById('rp-submit');
    btn.disabled = true;
    btn.textContent = 'Saving...';
    try {
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: <%- JSON.stringify(resetEmail) %>,
          token: <%- JSON.stringify(resetToken) %>,
          password
        })
      });
      const data = await res.json();
      if (data.ok) {
        okBox.textContent = data.message;
        okBox.classList.remove('hidden');
        document.getElementById('reset-form').classList.add('hidden');
        setTimeout(() => { window.location.href = '/account?action=login'; }, 2000);
      } else {
        errBox.textContent = data.message || 'Could not reset password';
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Set New Password';
      }
    } catch {
      errBox.textContent = 'Network error. Please try again.';
      errBox.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Set New Password';
    }
  });
</script>
<% } %>
