{
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-undef": "error",
    "no-async-promise-executor": "error"
  },
  "ignorePatterns": [
    "node_modules/",
    "public/",
    "seeds/",
    "scripts/check-*"
  ]
}