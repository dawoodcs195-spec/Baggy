{
  "name": "baggy-jeans-shop",
  "version": "1.0.0",
  "description": "Full-stack e-commerce website for baggy jeans and shirts",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/productSeed.js",
    "seed:coupons": "node seeds/couponSeed.js",
    "audit:renders": "node scripts/audit-renders.js",
    "audit:routes": "node scripts/audit-route-scopes.js",
    "audit": "node scripts/audit-security.js",
    "smoke": "node scripts/smoke-templates.js",
    "check": "node scripts/check-phase1.js && node scripts/check-phase2.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint server.js routes/ middleware/ services/ utils/ tests/ scripts/",
    "lint:fix": "eslint --fix server.js routes/ middleware/ services/ utils/ tests/ scripts/",
    "format": "prettier --write \"**/*.js\" \"**/*.json\" \"**/*.css\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.js\" \"**/*.json\" \"**/*.css\" --ignore-path .gitignore",
    "hooks:install": "node scripts/install-hooks.js",
    "load": "node scripts/load-test.js",
    "load:api": "node scripts/load-test-api.js"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.20.0",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.19.0",
    "helmet": "^7.0.0",
    "mongoose": "^8.8.0",
    "multer": "^2.3.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.0.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  },
  "author": "",
  "license": "ISC"
}
